NEXUSAI_ENVIRONMENT=development
NEXUSAI_LOG_LEVEL=INFO
NEXUSAI_DOCS_ENABLED=true
NEXUSAI_DATABASE_URL=
NEXUSAI_DATABASE_CONNECT_TIMEOUT_SECONDS=3
NEXUSAI_DATABASE_STATEMENT_TIMEOUT_MS=3000
NEXUSAI_PROCESS_DOCUMENTS=true
# Optional configured Ollama service. Leave empty for keyword search and quoted answers.
NEXUSAI_OLLAMA_URL=
NEXUSAI_EMBEDDING_MODEL=all-minilm
NEXUSAI_ANSWER_MODEL=
# Optional private cross-encoder endpoint compatible with TEI POST /rerank.
NEXUSAI_RERANK_URL=
# Optional password reset email. Set the full frontend origin and use implicit SMTP TLS.
NEXUSAI_RESET_PUBLIC_ORIGIN=
NEXUSAI_SMTP_HOST=
NEXUSAI_SMTP_PORT=465
NEXUSAI_SMTP_SENDER=
NEXUSAI_SMTP_USERNAME=
NEXUSAI_SMTP_PASSWORD=
# Used only by the optional Compose database profile.
NEXUSAI_POSTGRES_PASSWORD=
# Set these in the shell for the Windows launcher to override its default ports.
# NEXUSAI_BACKEND_PORT=8000
# NEXUSAI_FRONTEND_PORT=3000
